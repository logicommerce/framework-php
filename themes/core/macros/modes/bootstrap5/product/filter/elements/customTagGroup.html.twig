{%- macro elements(filters, appliedFilters, group) -%}

    {%- set ctBoolShowed = '' -%}
    {%- set ctBoolShowValue = '' -%}
    {%- for customTagId in group.customTags -%}
        {%- for customTag in filters.filterCustomTag|filter(customTag => customTag.id == customTagId) -%}
            {%- for item in customTag.customTagValues -%}
                {%- if customTag.controlType == constant('SDK\\Core\\Enums\\CustomTagControlType::BOOLEAN') -%}
                    {%- if '#' ~ customTag.name ~ '#' in ctBoolShowed -%}
                        {% set ctBoolShowValue = ctBoolShowValue ~ '/#' ~ customTag.name ~ '#' %}
                    {%- else -%}
                        {% set ctBoolShowed = ctBoolShowed ~ '/#' ~ customTag.name ~ '#' %}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endfor -%}
    {%- endfor -%}

    {%- for customTagId in group.customTags -%}
        {%- for customTag in filters.filterCustomTag|filter(customTag => customTag.id == customTagId) -%}
            {%- set parsedControlType = '' -%}
            {%- for controlTypePart in customTag.controlType|split('_') -%}
                {%- set parsedControlType = parsedControlType ~ controlTypePart|lower|capitalize -%}
            {%- endfor -%}
            {%- set isImageType = customTag.controlType == constant('SDK\\Core\\Enums\\CustomTagControlType::IMAGE')
                or customTag.controlType == constant('SDK\\Core\\Enums\\CustomTagControlType::SINGLE_SELECTION_IMAGE')
                or customTag.controlType == constant('SDK\\Core\\Enums\\CustomTagControlType::MULTIPLE_SELECTION_IMAGE') -%}
            {%- set isMultipleSelection = customTag.controlType == constant('SDK\\Core\\Enums\\CustomTagControlType::MULTIPLE_SELECTION') -%}
            {%- set isMultipleSelectionImage = customTag.controlType == constant('SDK\\Core\\Enums\\CustomTagControlType::MULTIPLE_SELECTION_IMAGE') -%}
            {%- set customTagValues = customTag.customTagValues -%}
            {# Merge applied values for multi-select so user-picked options stay visible after faceted narrowing #}
            {%- if appliedFilters[constant('FWK\\Enums\\Parameters::FILTER_CUSTOMTAG')] is defined
                and appliedFilters[constant('FWK\\Enums\\Parameters::FILTER_CUSTOMTAG')][customTag.id] is defined
                and (isMultipleSelection or isMultipleSelectionImage) -%}
                {%- set knownFilterValues = customTagValues|map(item => item.filterValue) -%}
                {%- for appliedValue in appliedFilters[constant('FWK\\Enums\\Parameters::FILTER_CUSTOMTAG')][customTag.id] -%}
                    {%- if appliedValue not in knownFilterValues -%}
                        {%- set customTagValues = customTagValues|merge([{ 'value': appliedValue, 'filterValue': appliedValue, 'name': null }]) -%}
                        {%- set knownFilterValues = knownFilterValues|merge([appliedValue]) -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}
            {%- for item in customTagValues -%}
                {%- set uid = random(10000000, 99999999) -%}
                {%- set checkValue = item.filterValue -%}
                {%- set value = item.value -%}
                {%- set selected = appliedFilters[constant('FWK\\Enums\\Parameters::FILTER_CUSTOMTAG')] is defined and appliedFilters[constant('FWK\\Enums\\Parameters::FILTER_CUSTOMTAG')][customTag.id] is defined and checkValue in appliedFilters[constant('FWK\\Enums\\Parameters::FILTER_CUSTOMTAG')][customTag.id] -%}
                <div
                    class="form-group form-check filterElement customTagsFilterElement customTagType{{ parsedControlType }}"
                    data-ct='{{ outputJsonHtmlString({ position: customTag.position, group: customTag.groupPosition, type: customTag.controlType }) }}'
                >
                    <input
                        class="form-check-input filterElement customTagsFilterElement"
                        type="checkbox"
                        name="{{ constant('FWK\\Enums\\Parameters::FILTER_CUSTOMTAG') }}{{ constant('FWK\\Core\\FilterInput\\FilterInputHandler::DYNAMIC_NAME_PARAM_DELIMITER') }}{{ customTag.id }}"
                        {% if selected %} checked {% endif %}
                        value="{{ checkValue|escape }}"
                        id="CTGFE{{ customTag.id }}_{{ uid }}"
                    >
                    {%- if customTag.controlType == constant('SDK\\Core\\Enums\\CustomTagControlType::DATE') -%}
                        {%- set value = value|date(getTwigDatePattern()) -%}
                    {%- elseif customTag.controlType == constant('SDK\\Core\\Enums\\CustomTagControlType::BOOLEAN') -%}
                        {%- set value = (value == '1' or value == 'true') ? languageSheet[constant('FWK\\Enums\\LanguageLabels::YES')] : languageSheet[constant('FWK\\Enums\\LanguageLabels::NO')] -%}
                    {%- elseif isImageType -%}
                        {%- if customTag.controlType == constant('SDK\\Core\\Enums\\CustomTagControlType::IMAGE') -%}
                            {# Legacy IMAGE: keep showing customTag.name as label (unchanged behavior) #}
                            {%- set value = '<img class="img-fluid customTagsFilterImage" src="' ~ (value|e('html_attr')) ~ '" alt="' ~ customTag.name|escape ~ '">' ~ customTag.name|escape -%}
                        {%- else -%}
                            {# For image selection types, only render label when a per-value name is provided #}
                            {%- set hasNameValue = item.name is not null and item.name|length -%}
                            {%- set imageAlt = hasNameValue ? item.name : customTag.name -%}
                            {%- set value = '<img class="img-fluid customTagsFilterImage" src="' ~ (value|e('html_attr')) ~ '" alt="' ~ imageAlt|escape ~ '">' ~ (hasNameValue ? item.name|escape : '') -%}
                        {%- endif -%}
                    {%- elseif customTag.controlType == constant('SDK\\Core\\Enums\\CustomTagControlType::NUMBER') -%}
                        {% if value matches '/[0-9]+(\.[0-9]+)?(e|E)[0-9]+/' %}
                            {%- set value = value|number_format(0, '.', '') -%}
                        {% else %}
                            {% set splitValue = value|split('.') %}
                            {%- if splitValue[1] == 0 -%}
                                {%- set value = splitValue[0] -%}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endif -%}
                    <label class="form-check-label filterElement customTagsFilterElement" for="CTGFE{{ customTag.id }}_{{ uid }}">
                        {%- if customTag.controlType == constant('SDK\\Core\\Enums\\CustomTagControlType::BOOLEAN') -%}
                            {{- customTag.name -}}
                            {{- '#' ~ customTag.name ~ '#' in ctBoolShowValue ? '(' ~ value ~ ')' : '' -}}
                        {%- else -%}
                            {{- value -}}
                        {%- endif -%}
                    </label>
                </div>
            {%- endfor -%}
        {%- endfor -%}
    {%- endfor -%}
{%- endmacro -%}
